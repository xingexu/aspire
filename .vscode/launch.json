{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FoodLink",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "${workspaceFolder}/app/server/server.js",
      "preLaunchTask": "FoodLink: install and build",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "listening on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
